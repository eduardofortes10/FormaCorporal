{
  "name": "forma",
  "version": "1.0.0",
  "private": true,
  "description": "Acompanhamento corporal com contas individuais e armazenamento persistente",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test tests.mjs progress.test.mjs server/app.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
